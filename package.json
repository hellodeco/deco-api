{
  "name": "api",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "watch": "ts-node-dev --respawn --exit-child --watch src src/index.ts",
    "build": "yarn compile && yarn copy-schema",
    "postinstall": "yarn build",
    "compile": "tsc",
    "copy-schema": "shx cp src/schema.graphql dist/schema.graphql",
    "start": "node ./dist/index.js",
    "generate-graphql": "graphql-codegen",
    "format": "prettier --write src",
    "knex": "knex --knexfile src/knexfile.ts"
  },
  "devDependencies": {
    "eslint": "^8.9.0",
    "eslint-config-prettier": "^8.4.0",
    "eslint-plugin-import": "^2.26.0",
    "prettier": "^2.5.1",
    "shx": "^0.3.4",
    "ts-node-dev": "^1.1.8",
    "typescript": "^4.5.5"
  },
  "dependencies": {
    "@graphql-codegen/cli": "^2.6.2",
    "@graphql-codegen/typescript": "^2.4.5",
    "@graphql-codegen/typescript-resolvers": "^2.5.2",
    "@graphql-tools/schema": "^8.3.1",
    "@notionhq/client": "^1.0.4",
    "@userfront/core": "^0.3.1",
    "apollo-server-core": "^3.6.7",
    "apollo-server-express": "^3.6.7",
    "body-parser": "^1.20.0",
    "camelcase": "^6.3.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.0.0",
    "express": "^4.17.3",
    "graphql": "^16.3.0",
    "graphql-middleware": "^6.1.14",
    "graphql-scalars": "^1.14.1",
    "graphql-shield": "^7.5.0",
    "jsonwebtoken": "^8.5.1",
    "knex": "^1.0.3",
    "node-fetch": "2.6.7",
    "pg": "^8.7.3",
    "snake-case": "^3.0.4",
    "stripe": "^8.217.0"
  }
}
