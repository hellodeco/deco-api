{
  "name": "api",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "watch": "concurrently --names \"copy-schema,compile,watch\" --prefix-colors \"bold.cyan,bold.yellow,bold.blue\" \"yarn copy-schema\" \"yarn compile --watch\" \"nodemon dist/index.js\"",
    "build": "yarn compile && yarn copy-schema",
    "postinstall": "yarn build",
    "compile": "tsc -p tsconfig.build.json",
    "copy-schema": "shx cp src/schema.graphql dist/schema.graphql",
    "start": "node ./dist/index.js",
    "generate-graphql": "graphql-codegen",
    "format": "prettier --write src",
    "knex": "knex --knexfile src/knexfile.ts",
    "test": "yarn jest --config ./jest.config.ts",
    "parser-watch": "concurrently --names \"compile,watch\" --prefix-colors \"bold.yellow,bold.blue\" \"yarn compile --watch\" \"nodemon dist/notion/html-parser.js\"",
    "compile-scripts": "yarn tsc --project tsconfig.scripts.json",
    "run-re-import-script": "yarn tsc --project tsconfig.json && node dist/scripts/import-failed-emails-to-notion.js",
    "notion-import-tester": "yarn compile-scripts && shx cp -R src/scripts/html compiled-scripts/scripts && node compiled-scripts/scripts/test-notion-email-import.js"
  },
  "devDependencies": {
    "@types/jest": "^27.5.1",
    "concurrently": "^7.3.0",
    "eslint": "^8.9.0",
    "eslint-config-prettier": "^8.4.0",
    "eslint-plugin-import": "^2.26.0",
    "jest": "^28.1.0",
    "nodemon": "^2.0.19",
    "prettier": "^2.5.1",
    "ts-jest": "^28.0.2",
    "typescript": "^4.6.4"
  },
  "dependencies": {
    "@apollo/server": "^4.0.0",
    "@aws-sdk/client-s3": "^3.135.0",
    "@graphql-codegen/cli": "^2.6.2",
    "@graphql-codegen/typescript": "^2.4.5",
    "@graphql-codegen/typescript-resolvers": "^2.5.2",
    "@graphql-tools/schema": "^8.3.1",
    "@notionhq/client": "^2.2.3",
    "@userfront/core": "^0.3.5",
    "bcrypt": "^5.1.0",
    "body-parser": "^1.20.0",
    "busboy": "^1.6.0",
    "camelcase": "^6.3.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.0.0",
    "express": "^4.17.3",
    "graphql": "^16.3.0",
    "graphql-middleware": "^6.1.14",
    "graphql-scalars": "^1.14.1",
    "graphql-shield": "^7.5.0",
    "jsonwebtoken": "^8.5.1",
    "knex": "^1.0.3",
    "knex-paginate": "^3.0.2",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "2.6.7",
    "pg": "^8.7.3",
    "puppeteer": "^17.1.3",
    "shx": "^0.3.4",
    "snake-case": "^3.0.4",
    "stripe": "^8.217.0",
    "uuid": "^8.3.2"
  }
}
