{
  "extends": ["prettier"],
  "rules": {
    "arrow-parens": 0,
    "no-restricted-globals": 0,
    "no-restricted-syntax": ["off", "ForOfStatement"],
    "function-paren-newline": [1, "consistent"],
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "js": "never",
        "jsx": "never",
        "ts": "never",
        "tsx": "never"
      }
    ],
    "import/prefer-default-export": 0
  },
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [".js", ".jsx", ".ts", ".tsx"]
      }
    }
  },
  "parserOptions": {
    "sourceType": "module",
    "ecmaVersion": "latest"
  },
  "plugins": ["import"]
}
